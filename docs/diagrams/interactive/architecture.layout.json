  "connections": [
    {
      "id": "local-request",
      "from": "browser",
      "to": "preparation",
      "variant": "emphasis",
      "label": "本地 HTTP"
    },
    {
      "id": "confirmed-handoff",
      "from": "preparation",
      "to": "workbench",
      "variant": "emphasis",
      "label": "确认后交接"
    },
    {
      "id": "free-edit-call",
      "from": "preparation",
      "to": "image_api",
      "variant": "dashed",
      "label": "选择自由改图"
    },
    {
      "id": "skill-call",
      "from": "workbench",
      "to": "image_api",
      "variant": "dashed",
      "label": "勾选 skill"
    },
    {
      "id": "image-process",
      "from": "workbench",
      "to": "image_algorithms",
      "variant": "emphasis",
      "label": "统一处理"
    },
    {
      "id": "editable-curves",
      "from": "image_algorithms",
      "to": "path_document",
      "variant": "emphasis",
      "label": "拟合与编辑"
    },
    {
      "id": "compile-plan",
      "from": "path_document",
      "to": "robot_client",
      "variant": "emphasis",
      "label": "采样编译"
    },
    {
      "id": "tcp-commands",
      "from": "robot_client",
      "to": "rapid_queue",
      "variant": "emphasis",
      "label": "TCP 指令"
    },
    {
      "id": "consume-queue",
      "from": "rapid_queue",
      "to": "rapid_motion",
      "variant": "emphasis",
      "label": "取队列执行"
    },
    {
      "id": "pen-motion",
      "from": "rapid_motion",
      "to": "physical_drawing",
      "variant": "emphasis",
      "label": "落笔 / 抬笔"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "本地与 API 的边界",
      "items": [
        "浏览器和工作台由同一本地 Python 应用组织。",
        "本地抠图与固定 WAV 提示不依赖实时 API 调用。",
        "前端改图与 skill 共用本机 API 配置。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可编辑的几何链路",
      "items": [
        "两种 skill 状态进入相同的二值化和路径流程。",
        "异常拟合按原线分段重拟合；当前轮廓决定区域填充。",
        "最终预览和 MOVEL 计划均来自当前路径文档。"
      ]
    },
    {
      "dot": "orange",
      "title": "ABB 执行与确认",
      "items": [
        "容量内边收边画；超容量按完整路径分批确认。",
        "批尾 Stamp 与空闲状态共同确认执行完成。",
        "前端拍照位请求经本地应用转发，等待实际到位后拍摄。"
      ]
    }
  ],
  "format": "xiaohua-diagram-v1",
  "scenes": [
